# Copy to .env for local development. On Render, set these as environment
# variables in the service dashboard instead - never commit real values.

NODE_ENV=development
PORT=5000

MONGO_URI=

# Access token signing secret (required). Keep this out of source control.
JWT_SECRET=
# Optional: separate secret for refresh tokens. Falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
